[Unit]
Description=Hiddify best-node failover for Cursor
After=network-online.target

[Service]
Type=simple
Environment=HIDDIFY_PATCH_NONINTERACTIVE=1
# Run `./bin/hiddify-cursor-failover patch` once in a terminal (sudo), then reconnect Hiddify.
ExecStart=/home/mohammadesmailzade/Tools/hiddify-code-agent-failover/bin/hiddify-cursor-failover watch --skip-patch --interval 20 --bad-ms 1500 --fail-threshold 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
