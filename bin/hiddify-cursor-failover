#!/usr/bin/env bash
# Cache Hiddify Clash secret once, then run the failover tool.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPT="$ROOT_DIR/hiddify_cursor_failover.py"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hiddify-cursor"
SECRET_FILE="$CONF_DIR/clash_secret"
PORT_FILE="$CONF_DIR/clash_port"

export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
cd "$ROOT_DIR"

mkdir -p "$CONF_DIR"
chmod 700 "$CONF_DIR"

_read_clash_api() {
  local cfg="$1"
  python3 - "$cfg" <<'PY'
import json, sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    api = json.load(f).get("experimental", {}).get("clash_api") or {}
secret = api.get("secret")
controller = api.get("external_controller") or "127.0.0.1:16756"
if not secret:
    raise SystemExit("missing secret")
print(secret)
print(controller)
PY
}

_detect_live_port() {
  local port="$1"
  if ss -ltn | awk '{print $4}' | grep -qE ":16757$"; then
    echo 16757
  elif ss -ltn | awk '{print $4}' | grep -qE ":${port}$"; then
    echo "$port"
  elif ss -ltn | awk '{print $4}' | grep -qE ":16756$"; then
    echo 16756
  else
    echo "$port"
  fi
}

_hiddify_runs_as_root() {
  pgrep -u root -x hiddify >/dev/null 2>&1
}

_verify_clash_secret() {
  local secret="$1" port="$2"
  python3 - "$secret" "$port" <<'PY'
import sys, urllib.request, urllib.error
secret, port = sys.argv[1], sys.argv[2]
req = urllib.request.Request(
    f"http://127.0.0.1:{port}/version",
    headers={"Authorization": f"Bearer {secret}"},
)
try:
    with urllib.request.urlopen(req, timeout=3) as resp:
        sys.exit(0 if 200 <= resp.status < 300 else 1)
except Exception:
    sys.exit(1)
PY
}

_cache_secret() {
  local source="$1" secret="$2" controller="$3"
  local port="${controller##*:}"
  port="$(_detect_live_port "$port")"
  if ! _verify_clash_secret "$secret" "$port"; then
    echo "Secret from $source does not authenticate to Clash API on port $port" >&2
    return 1
  fi
  umask 077
  printf '%s\n' "$secret" >"$SECRET_FILE"
  printf '%s\n' "$port" >"$PORT_FILE"
  echo "Cached secret -> $SECRET_FILE (port $port)"
}

refresh_secret() {
  local candidates=()
  if [[ -n "${HIDDIFY_ROOT_CONFIG:-}" ]]; then
    candidates+=("$HIDDIFY_ROOT_CONFIG")
  fi
  while IFS= read -r path; do
    candidates+=("$path")
  done < <(
    python3 - <<'PY'
from hiddify_cursor_patch import config_path_candidates
for path in config_path_candidates():
    print(path)
PY
  )

  local cfg secret port controller
  for cfg in "${candidates[@]}"; do
    if [[ "$cfg" == /root/* ]]; then
      if { read -r secret && read -r controller; } < <(
        sudo python3 - "$cfg" <<'PY'
import json, sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    api = json.load(f).get("experimental", {}).get("clash_api") or {}
secret = api.get("secret")
controller = api.get("external_controller") or "127.0.0.1:16756"
if not secret:
    raise SystemExit("missing secret")
print(secret)
print(controller)
PY
      2>/dev/null); then
        echo "Using Clash API secret from $cfg (sudo)"
        if _cache_secret "$cfg" "$secret" "$controller"; then
          return 0
        fi
      fi
      continue
    fi
    if _hiddify_runs_as_root; then
      echo "Skipping $cfg (Hiddify is running as root; user-home secret would 401)" >&2
      continue
    fi
    [[ -f "$cfg" ]] || continue
    if { read -r secret && read -r controller; } < <(_read_clash_api "$cfg" 2>/dev/null); then
      echo "Using Clash API secret from $cfg"
      if _cache_secret "$cfg" "$secret" "$controller"; then
        return 0
      fi
    fi
  done

  echo "Could not read a working Clash API secret from any Hiddify config." >&2
  echo "Tried: ${candidates[*]}" >&2
  if _hiddify_runs_as_root; then
    echo "Hiddify is running as root. Re-run in a terminal with sudo:" >&2
    echo "  ./bin/hiddify-cursor-failover refresh-secret" >&2
  else
    echo "Start Hiddify, then: ./bin/hiddify-cursor-failover refresh-secret" >&2
  fi
  return 1
}

apply_root_bypass() {
  # Live Hiddify (sudo) ignores the user-home config copy. Write root config
  # so LAN DNS + RFC1918 excludes actually take effect.
  sudo -E env PYTHONPATH="$ROOT_DIR" HIDDIFY_ENV_FILE="$ROOT_DIR/.env" \
    python3 - "$ROOT_DIR" <<'PY'
import json
import sys
from pathlib import Path

from hiddify_bypass import apply_bypass_to_config, load_bypass_spec
from hiddify_cursor_patch import config_path_candidates

root = Path(sys.argv[1])
spec = load_bypass_spec()
applied = False
for path in config_path_candidates():
    p = Path(path)
    if not str(p).startswith("/root/") or not p.is_file():
        continue
    cfg = json.loads(p.read_text(encoding="utf-8"))
    changes = apply_bypass_to_config(cfg, spec)
    applied = True
    if not changes:
        print(f"Bypass already applied in {p}")
        continue
    bak = Path(str(p) + ".bak-failover")
    if not bak.exists():
        bak.write_text(p.read_text(encoding="utf-8"), encoding="utf-8")
    p.write_text(json.dumps(cfg, separators=(",", ":"), ensure_ascii=False), encoding="utf-8")
    print(f"Applied bypass to {p}")
    for line in changes:
        print(f"  {line}")
if not applied:
    sys.exit("No root Hiddify current-config.json found")
PY
}

cmd="${1:-}"
if [[ "$cmd" == "refresh-secret" ]]; then
  refresh_secret
  apply_root_bypass || true
  exit 0
fi

if [[ "$cmd" == "patch" || "$cmd" == "once" || "$cmd" == "watch" || ( "$cmd" == "bypass" && " $* " == *" --apply "* ) ]]; then
  if _hiddify_runs_as_root; then
    apply_root_bypass || echo "note: could not write root Hiddify config (sudo). LAN DNS bypass needs: sudo $0 bypass --apply" >&2
  fi
fi

if [[ ! -f "$SECRET_FILE" ]]; then
  refresh_secret
fi

export HIDDIFY_CLASH_SECRET
HIDDIFY_CLASH_SECRET="$(cat "$SECRET_FILE")"
port="$(cat "$PORT_FILE" 2>/dev/null || echo 16757)"
export HIDDIFY_CLASH_API="http://127.0.0.1:${port}"

exec python3 "$SCRIPT" "$@"
